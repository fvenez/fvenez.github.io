@misc{Talk-56, date={2026-03-26}, month={3}, year={2026}, title={Rational angles in plane lattices}, note={at the university of Grenoble},
abstract={Generalising classical questions about regular polygons with vertices on a plane lattice, we are interested in pairs of lattice points $A, B$ such that the angle $\widehat{AOB}$ is a rational multiple of $\pi$. This problem leads to diophantine-trigonometric equations that in turn involve the study of rational points on curves of genus 0,1,2,3,5. I will present the full classification of plane lattices according to how many independent rational angles they contain and in which configurations they appear. This is a joint work with R. Dvornicich, D. Lombardo and U. Zannier}
}

@misc{Talk-55, date={2025-12-05}, month={12}, year={2025}, title={On the disk of convergence of algebraic power series}, note={during the \textit{December workshop in Number Theory}, in Pisa},
abstract={In a recent work with U. Zannier we considered the disk of convergence of a power series $s(x)$ representing an algebraic function of $x$ and specifically the relation between this disk and the branch points of the $x$-coordinate on the corresponding algebraic curve. We focus especially on the $p$-adic case, answering some questions of basic nature, seemingly absent from the existing literature.
To illustrate the issues, recall that in the complex case the open disk of convergence cannot contain all the branch points of $x$, except for the trivial case of a rational function. In the p-adic case, we show that the analogous assertion is not true in complete generality; but we also confirm it in a number of cases, for instance under the assumption that $p$ is not smaller than the degree of $s(x)$ over the field of rational functions of $x$.}
}

@misc{Talk-54, date={2025-11-11}, month={11}, year={2025}, title={The field of definition of the iterates of a rational function}, note={during the conference \textit{Diophantine approximation and transcendence}, in Luminy},
abstract={In this joint work with Solomon Vishkautsan we study how the field of definition of a rational function changes under iteration. We provide a complete classification of polynomials with algebraic coefficients with the property that one of their iterates is defined over a smaller field than the polynomial itself. We show with families of examples originating from algebraic groups that this characterization does not hold for rational functions. Finally, we also classify fractional linear transformations with this property.}
}

@misc{Talk-53, date={2025-01-10}, month={1}, year={2025}, title={The field of iterates of a rational function}, note={at the university of Udine},
abstract={In this joint work with Solomon Vishkautsan we study how the field of definition of a rational function changes under iteration. We provide a complete classification of polynomials with the property that the field of definition of one of their iterates drops in degree (over a given base field). We show with families of examples that this characterization does not hold for rational functions. Finally, we also classify fractional linear transformations with this property. }
}

